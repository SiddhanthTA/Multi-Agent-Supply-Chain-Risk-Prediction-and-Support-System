# Database
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME

# JWT Authentication
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# News API
NEWS_API_KEY=YOUR_NEWS_API_KEY
NEWS_API_BASE_URL=YOUR_NEWS_API_BASE_URL
NEWS_LANGUAGE=en
NEWS_PAGE_SIZE=20
NEWS_SEARCH_QUERY=YOUR_SEARCH_QUERY
NEWS_TARGETED_QUERIES_ENABLED=true
NEWS_TARGETED_QUERY_INTERVAL_MINUTES=360
NEWS_TARGETED_PAGE_SIZE=10
NEWS_TARGETED_LOCATION_ROTATION=India,United States,Singapore
NEWS_TARGETED_QUERY_INDIA=India AND (shipping OR logistics OR "supply chain" OR port OR freight OR energy OR fuel OR refinery OR imports OR exports) AND (disruption OR delay OR shortage OR strike OR restriction OR closure OR congestion OR blockade)
NEWS_TARGETED_QUERY_UNITED_STATES=("United States" OR USA OR US) AND (shipping OR logistics OR "supply chain" OR port OR freight OR energy OR fuel OR refinery OR imports OR exports) AND (disruption OR delay OR shortage OR strike OR restriction OR closure OR congestion OR blockade)
NEWS_TARGETED_QUERY_SINGAPORE=Singapore AND (shipping OR logistics OR "supply chain" OR port OR freight OR container OR maritime OR energy OR fuel OR imports OR exports) AND (disruption OR delay OR shortage OR strike OR restriction OR closure OR congestion OR blockade)

# Primary intelligence workspace; weather cities are not news workspace locations
PRIMARY_INTELLIGENCE_COUNTRIES=India,United States

# Weather API
WEATHER_API_KEY=YOUR_WEATHER_API_KEY
WEATHER_API_BASE_URL=YOUR_WEATHER_API_BASE_URL
DEFAULT_WEATHER_CITY=YOUR_CITY

# Default Event Configuration
DEFAULT_EVENT_LOCATION=YOUR_DEFAULT_LOCATION
DEFAULT_EVENT_SEVERITY=YOUR_DEFAULT_SEVERITY
DEFAULT_EVENT_STATUS=YOUR_DEFAULT_STATUS

# Local Risk Investigation Agent
INVESTIGATION_PROVIDER=local
INVESTIGATION_MODEL_PATH=HuggingFaceTB/SmolLM2-135M-Instruct
INVESTIGATION_MODEL_NAME=SmolLM2-135M-Instruct
INVESTIGATION_CONTEXT_TOKENS=2048
INVESTIGATION_MAX_NEW_TOKENS=120
INVESTIGATION_TIMEOUT_SECONDS=120
INVESTIGATION_ALLOWED_ROLES=admin,analyst
INVESTIGATION_LOCAL_FILES_ONLY=true

# Scheduler
NEWS_COLLECTION_INTERVAL_MINUTES=30
